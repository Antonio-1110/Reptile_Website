# Copy to Frontend/.env.local to override locally. Vite bakes VITE_* values into the build, so on
# Vercel set them in the project's Environment Variables and redeploy after changing them.

# The backend's /api base URL (no trailing slash). Defaults to http://localhost:8000/api.
# VITE_API_URL=https://api.reptilian.app/api

# The OAuth client ID for "Continue with Google" (same value as the backend's DJANGO_GOOGLE_CLIENT_ID).
# Leave unset to hide the button.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
