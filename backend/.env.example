# Copy to backend/.env for local development. Real environment variables override this file.
# Never commit the real .env.

# Local development: turns on DEBUG, the dev login bypass, and a throwaway secret key.
DJANGO_DEBUG=1

# Production: DJANGO_DEBUG must be unset/0 and all of these set.
# DJANGO_SECRET_KEY=generate-with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# DJANGO_ALLOWED_HOSTS=api.example.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DATABASE_URL=postgres://user:password@host:5432/dbname   # PostgreSQL; Heroku Postgres sets this. Unset = SQLite
# DJANGO_DATABASE_SSL=1                             # require TLS to the database (default: on unless DEBUG)
# DJANGO_SQLITE_PATH=db.sqlite3                     # SQLite file (dev/tests)
# DJANGO_MEDIA_ROOT=/var/lib/reptile/media          # uploaded photos on local disk (when S3 isn't set)
# DJANGO_S3_BUCKET=example-photos                   # store uploaded photos on S3 instead of local disk
# DJANGO_S3_REGION=ap-northeast-1
# DJANGO_S3_CUSTOM_DOMAIN=photos.example.com        # optional, e.g. a CDN in front of the bucket
# AWS_ACCESS_KEY_ID=...                             # IAM user allowed to put/delete objects in the bucket
# AWS_SECRET_ACCESS_KEY=...
# DJANGO_SECURE_SSL_REDIRECT=1                      # redirect HTTP to HTTPS (default: on unless DEBUG)
# DJANGO_SECURE_HSTS_SECONDS=31536000               # HSTS max-age (default: one year unless DEBUG)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=...
# DJANGO_EMAIL_HOST_PASSWORD=...
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com
# DJANGO_ADMINS=staff@example.com                  # gets order problem reports
# DJANGO_FRONTEND_URL=https://example.com          # the website, for links in emails
# DJANGO_BACKEND_URL=https://api.example.com       # this API, for payment providers to call back
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0  # error alerts to Sentry; unset = none sent

# Card payments through ECPay (auction/ecpay.py). Unset = staff confirm payments in the admin
# (instantly paid when DJANGO_DEBUG=1). The values below are ECPay's public test merchant: payments go
# to payment-stage.ecpay.com.tw and no real money moves until ECPAY_LIVE=1 with your own merchant.
# AUCTION_PAYMENT_GATEWAY=auction.ecpay.ECPayGateway
# ECPAY_MERCHANT_ID=3002607
# ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
# ECPAY_HASH_IV=EkRm7iFT261dpevs
# ECPAY_LIVE=0
# ECPAY_MANUAL_SETTLEMENT=0          # 1 once automatic settlement (自動關帳) is off in ECPay's back office

# Marketplace policy (all optional; defaults in settings.py). Placeholders until decided.
# AUCTION_MAX_DURATION_DAYS=14      # longest auction; keep under the processor's 21-day limit on held deposits
# ORDER_PAYMENT_HOURS=48            # winner pays the rest within this, or loses the deposit
# ORDER_RUNNER_UP_OFFER_HOURS=48    # runner-up has this long to accept a seller's offer
# ORDER_HANDOVER_DAYS=5             # seller hands over / ships within this after payment
# ORDER_CONFIRM_DAYS=3              # buyer confirms (or reports a problem) within this
# PLAN_PRICE_COMMERCIAL=299         # monthly price of the Commercial plan (the upgrade page says free for now)
# PLAN_PRICE_PRO=499                # monthly price of Commercial Pro
# PLAN_HOBBYIST_MAX_LISTINGS=5      # listings a Hobbyist account may have
# PLAN_HOBBYIST_MAX_PHOTOS=3        # photos per listing on Hobbyist
# PLAN_COMMERCIAL_MAX_LISTINGS=20   # ...on Commercial
# PLAN_COMMERCIAL_MAX_PHOTOS=6
# PLAN_PRO_MAX_LISTINGS=200         # ...on Commercial Pro
# PLAN_PRO_MAX_PHOTOS=12
# AUCTION_FEE_RATE_COMMERCIAL=0.05  # marketplace fee taken from auction payouts on Commercial
# AUCTION_FEE_RATE_PRO=0.03         # ...and on Commercial Pro (each auction keeps the rate it started with)
# LAUNCH_OFFER_DAYS=182             # early sellers pay no auction fee for this long after joining; 0 = no offer
# LAUNCH_OFFER_JOINED_BEFORE=       # YYYY-MM-DD: accounts joining on or after this don't get the offer; unset = everyone does
# SELLER_BOND_AMOUNT=0              # bond sellers post before auctioning; 0 = not required
# INCIDENT_REVIEW_THRESHOLD=2       # incidents before an account is flagged for review
# AUCTION_EXTEND_WINDOW_MINUTES=5   # anti-sniping: a bid this close to the end extends the auction
# AUCTION_EXTEND_BY_MINUTES=5       # ...to at least this long after that bid; window 0 = off
# REPORT_AUTO_HIDE_THRESHOLD=0      # different reporters before a listing is hidden for review; 0 = off
# SAVED_SEARCH_LIMIT=20             # saved searches (with email alerts) per account
# PRICE_DROP_EMAIL_HOURS=24         # at most one price-drop email per saved listing in this time

# Rate limits (DRF format: N/second|minute|hour|day). Defaults in settings.py.
# DJANGO_THROTTLE_AUTH=10/minute
# DJANGO_THROTTLE_CONTACT=20/hour
# DJANGO_THROTTLE_REPORT=20/hour
# DJANGO_THROTTLE_PAYMENTS=30/hour
# DJANGO_THROTTLE_EMAIL=5/hour

# Admin (all optional). In production, move the admin off /admin/, where bots look for it.
# DJANGO_ADMIN_URL=admin/           # e.g. staff-x7k2q9/ ; the admin is then at /staff-x7k2q9/
# LOGIN_LOCKOUT_FAILURES=5          # wrong passwords in a row before admin sign-in is refused...
# LOGIN_LOCKOUT_MINUTES=15          # ...for this long (per username and per client address)

# Google sign-in (optional; DEPLOYMENT.md section 6). The OAuth client ID, same as the frontend's
# VITE_GOOGLE_CLIENT_ID. Unset turns it off.
# DJANGO_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
